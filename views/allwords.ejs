<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AllWords</title>
</head>
<body>
    <h1>ALL WORDS: ALPHABETIZED</h1>
    <p>All words from allwords.txt should load in order</p>
    <br>
    <% for (let i = 0; i < allMyWords.length; i++) { %>
        <p>
            <b> <%= allMyWords[i][0] %> </b> 
            ( <%= allMyWords[i][1] %> ) - <%= allMyWords[i][2] %>
        </p>
    <% } %>
</body>
</html>